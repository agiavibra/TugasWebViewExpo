{
  "expo": {
    "name": "TugasWebViewExpo",
    "slug": "TugasWebViewExpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tugaswebviewexpo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.tugas.webviewfabric"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tugas.webviewfabric"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
